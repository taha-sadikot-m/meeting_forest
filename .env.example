# Copy to .env.local and fill in your credentials

PORT=3000

# LiveKit — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Memgraph (Bolt protocol) — defaults to localhost:7687
MEMGRAPH_HOST=your-memgraph-host-or-ip
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASS=

# Resend — product emails only (meeting invite, debrief, platform invite)
# Auth verification / password-reset emails are sent by Cognito.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_EMAIL_ADDRESS=noreply@yourdomain.com

# App public URL (used in email links)
APP_URL=http://localhost:3000

# AWS Cognito — user signup, email codes, login, password reset
# Create a User Pool: email sign-in, self-registration, Cognito-managed email verification.
# App client: generate a client secret; enable ALLOW_USER_PASSWORD_AUTH + ALLOW_REFRESH_TOKEN_AUTH.
# Existing Memgraph users: register once with the same email to keep meetings/data.
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deepgram — agent voice (TTS replies + STT spoken commands) https://console.deepgram.com
DEEPGRAM_API_KEY=
# Optional overrides:
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# DEEPGRAM_STT_MODEL=nova-2

# Temporal — local Docker stack (localhost:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Shared secret for Temporal worker → server internal API calls
WORKER_INTERNAL_SECRET=change-me-in-production

# Platform admin login (/admin/login) — leave empty to disable admin access
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
